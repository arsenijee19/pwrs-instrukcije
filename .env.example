# Lozinka za /admin. Preporuka: hash (npm run admin:hash), ne čist tekst.
ADMIN_PASSWORD_HASH=
# Alternativa za lokalni razvoj (ne koristiti u produkciji):
# ADMIN_PASSWORD=
# Dugačak nasumičan string za potpis sesije (npr. `openssl rand -hex 32`). OBAVEZNO u produkciji.
SESSION_SECRET=
# Gde se čuvaju baza i uploadovane slike (mora biti trajni disk/volume). Podrazumevano ./data
DATA_DIR=./data
# Javni URL sajta
NEXT_PUBLIC_SITE_URL=https://instrukcije.playworld.rs
